# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Timezone (defaults to Asia/Kolkata / IST)
BOT_TIMEZONE=Asia/Kolkata

# Default Winter Arc Role ID (pinged at reminders & assigned on /enroll)
WINTER_ARC_ROLE_ID=your_role_id_here

# Optional: Channel ID where daily results and broadcasts are posted (can also be configured via /set_channel)
DAILY_RESULTS_CHANNEL_ID=

# Optional: Guild (Server) ID for instantaneous slash command sync during local testing
TEST_GUILD_ID=

# Google Gemini API Key (powers /grind evaluation and Midnight/Weekly digests)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Groq API Key (powers fast NLP workout logging and reactive nudges)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Streak Configuration
MIN_STREAK_POINTS=30

# Optional: Winter Arc Year Override (defaults to current year)
WINTER_ARC_YEAR=2026
