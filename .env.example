# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Default Winter Arc Role ID (can also be configured in-server via /admin set_role)
WINTER_ARC_ROLE_ID=your_role_id_here

# Optional: Dedicated Winter Arc Channel ID (can also be configured in-server via /admin set_channel)
WINTER_ARC_CHANNEL_ID=your_channel_id_here

# Security 2FA Hash for /nuke (SHA-256 hash of secret lowercase answer)
# Generate via: python -c "import hashlib; print(hashlib.sha256('your_answer'.encode()).hexdigest())"
NUKE_SECURITY_HASH=ae50ad81a2d4006e372c0bd3220f24c377345455d0e980c3f0d94f0e5faf2561

# OpenRouter API Key (primary reasoning tier for /grind evaluation, recaps, and Stoic quotes)
OPEN_ROUTER_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Groq API Key (powers fast /quick NLP workout logging, reactive nudges, and failover)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq inference model (defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Real-time unbuffered log stream (recommended for Pterodactyl / Docker panels)
PYTHONUNBUFFERED=1

