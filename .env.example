# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Guild (Server) ID for instantaneous slash command sync during local testing
# Right-click your server in Discord (with Developer Mode enabled) and choose "Copy Server ID"
TEST_GUILD_ID=

# Optional: Channel ID where 00:00 midnight daily results will be posted
DAILY_RESULTS_CHANNEL_ID=

# Timezone (defaults to Asia/Kolkata)
BOT_TIMEZONE=Asia/Kolkata
